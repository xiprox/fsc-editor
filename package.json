{
  "name": "fsc-editor",
  "private": true,
  "version": "0.1.0",
  "description": "Editor for FS Copilot aircraft profiles",
  "author": "xip",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "build:unpacked": "npm run build && electron-builder --win --dir",
    "release:win": "npm run build && electron-builder --win --publish always",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:format": "node --experimental-strip-types scripts/check-format.ts",
    "check:grammar": "node --experimental-strip-types scripts/check-grammar.ts",
    "check:setters": "node --experimental-strip-types scripts/check-setters.ts",
    "check:cascade": "node --experimental-strip-types scripts/check-cascade.ts",
    "check:highlight": "node --experimental-strip-types scripts/check-highlight.ts",
    "check:claims": "node --experimental-strip-types scripts/check-claims.ts",
    "corpus:sync": "node --experimental-strip-types scripts/corpus-sync.ts",
    "corpus:golden": "node --experimental-strip-types scripts/corpus-golden.ts",
    "merge:profile": "node --experimental-strip-types scripts/merge-profile.ts",
    "remote:sandbox": "node --experimental-strip-types scripts/remote-sandbox.ts",
    "sim:sandbox": "node --experimental-strip-types scripts/sim-sandbox.ts",
    "sim:slice": "node --experimental-strip-types scripts/slice-capture.ts",
    "sim:probe": "node --experimental-strip-types scripts/probe-input-events.ts",
    "sim:panels": "node --experimental-strip-types scripts/probe-panels.ts",
    "vars:catalog": "node --experimental-strip-types scripts/build-sdk-var-catalog.ts",
    "lang:sweep": "node --experimental-strip-types scripts/lang-sweep.ts",
    "lang:calibrate": "node --experimental-strip-types scripts/lang-calibrate.ts",
    "link:build": "node link/tools/bash.mjs link/build.sh",
    "link:read": "node --experimental-strip-types link/tools/read.ts",
    "relay:dev": "wrangler dev --config relay/wrangler.toml",
    "relay:deploy": "wrangler deploy --config relay/wrangler.toml",
    "relay:check": "tsc -p relay/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "check:module": "node --experimental-strip-types scripts/check-module.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "monaco-editor": "^0.55.1",
    "node-simconnect": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "regedit": "^5.1.4",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "yazl": "^3.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "playwright-core": "^1.62.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0",
    "yaml": "^2.9.0"
  }
}
